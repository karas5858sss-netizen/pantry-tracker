# ==============================================================
# Pantry Tracker - Environment Variables Template
# Copy to .env.local for local development.
# NEVER commit real secret keys or .env.local to version control!
# ==============================================================

# Supabase (Needed starting from Stage 1)
# Anon key is public and has NO direct table access due to RLS without policies.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Telegram Bot Name (for generating share links: https://t.me/<BOT>/<APP>?startapp=...)
VITE_TELEGRAM_BOT_NAME=your_bot_name

# --------------------------------------------------------------
# BACKEND SECRETS (Set ONLY in Supabase Secrets vault, NEVER on client):
# - BOT_TOKEN: Token from @BotFather for HMAC-SHA256 signature verification
# - CRON_SECRET: Secret Bearer token for scheduled reminders endpoint
# - SUPABASE_SERVICE_ROLE_KEY: Kept inside Edge Functions runtime
# --------------------------------------------------------------
